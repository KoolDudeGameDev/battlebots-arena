local Damage = require("../src/shared/Damage")
local Stats = require("../src/shared/Stats")
local Config = require("../src/shared/Config")

return function(test)
	test("no armor: all damage goes to health", function()
		local hp, armor, deflected, armorTaken, hpTaken = Damage.resolve(100, 0, 30, 0.3, 0, false)
		assert(hp == 70 and armor == 0 and not deflected and armorTaken == 0 and hpTaken == 30)
	end)

	test("armor absorbs first and overflow reaches health", function()
		local hp, armor, deflected, armorTaken, hpTaken = Damage.resolve(100, 20, 30, 0.1, 0.99, false)
		assert(hp == 90 and armor == 0 and not deflected and armorTaken == 20 and hpTaken == 10, `{hp} {armor}`)
	end)

	test("a low roll deflects while armor is up", function()
		local hp, armor, deflected = Damage.resolve(100, 20, 30, 0.1, 0.05, false)
		assert(deflected and hp == 100 and armor == 20)
	end)

	test("no deflect without armor, and never on splash", function()
		local _, _, deflected = Damage.resolve(100, 0, 30, 0.3, 0, false)
		assert(not deflected, "no armor")
		local _, _, splashDeflected = Damage.resolve(100, 50, 30, 0.3, 0, true)
		assert(not splashDeflected, "splash")
	end)

	test("armor plating: 30 then +20 per stack, deflect capped at 30%", function()
		local a0, d0 = Stats.armorFor(0, Config.Armor)
		assert(a0 == 0 and d0 == 0)
		local a1, d1 = Stats.armorFor(1, Config.Armor)
		assert(a1 == 30 and math.abs(d1 - 0.10) < 1e-9, `{a1} {d1}`)
		local a5, d5 = Stats.armorFor(5, Config.Armor)
		assert(a5 == 110 and math.abs(d5 - 0.30) < 1e-9, `{a5} {d5}`)
		local _, d9 = Stats.armorFor(9, Config.Armor)
		assert(math.abs(d9 - 0.30) < 1e-9, "cap")
	end)
end
